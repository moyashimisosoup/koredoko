{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/property-locator/listing_v0.2.schema.json",
  "title": "Property Locator Source-Aware Listing Input v0.2",
  "description": "Input contract: sources and original evidence must accompany claims. Cross-field evidence matching also requires procedural validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "listing", "evidence"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "method", "retrieved_at"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "url": {"type": ["string", "null"], "format": "uri"},
      "method": {"enum": ["approved_url_adapter", "pasted_text", "ai_json", "manual"]},
      "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
      "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
      "terms_checked": {"type": "boolean"}
    }}},
    "listing": {"type": "object", "additionalProperties": false, "required": ["stations", "nearby"], "properties": {
      "property_type": {"type": ["string", "null"]},
      "location_hint": {"type": ["string", "null"]},
      "stations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "walk_minutes", "travel_mode", "qualifier"], "properties": {
        "name": {"type": "string", "minLength": 1},
        "line": {"type": ["string", "null"]},
        "entity_id": {"type": ["string", "null"]},
        "walk_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 180},
        "travel_mode": {"enum": ["walk_only", "bus_plus_walk", "unknown"]},
        "qualifier": {"enum": ["exact_advertised", "approximate", "unknown"]}
      }}},
      "nearby": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "walk_minutes", "qualifier"], "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["named_place", "generic_category"]},
        "category": {"type": ["string", "null"]},
        "walk_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 180},
        "qualifier": {"enum": ["exact_advertised", "approximate", "unknown"]}
      }}},
      "built_year": {"type": ["integer", "null"], "minimum": 1850, "maximum": 2100},
      "building_floors": {"type": ["integer", "null"], "minimum": 1},
      "unit_floor": {"type": ["integer", "null"], "minimum": -5},
      "structure": {"type": ["string", "null"]},
      "area_sqm": {"type": ["number", "null"], "exclusiveMinimum": 0},
      "layout": {"type": ["string", "null"]}
    }},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["field_path", "source_id", "kind", "verbatim_excerpt"], "properties": {
      "field_path": {"type": "string", "minLength": 1},
      "source_id": {"type": "string", "minLength": 1},
      "kind": {"enum": ["explicit", "inferred", "unknown"]},
      "verbatim_excerpt": {"type": ["string", "null"]},
      "dependency_group": {"type": ["string", "null"]},
      "comment": {"type": ["string", "null"]}
    }}}
  }
}
